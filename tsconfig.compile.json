{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "./src/server",
    "outDir": "./dist/server",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
